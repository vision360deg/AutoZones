      "parameters": {
        "jsCode": "const html = $input.first().json.data\nconst url = $('Telegram Trigger').first().json.message.text\n\n// Helper to extract via regex\nfunction grab(tag, attr) {\n  const regex = new RegExp(`<${tag}[^>]*${attr}=[\"']([^\"']+)[\"'][^>]*>`, \"i\");\n  const match = html.match(regex);\n  return match ? match[1] : null;\n}\n\nfunction grabMeta(property) {\n  const regex = new RegExp(`<meta[^>]*(name|property)=[\"']${property}[\"'][^>]*content=[\"']([^\"']+)[\"'][^>]*>`, \"i\");\n  const match = html.match(regex);\n  return match ? match[2] : null;\n}\n\n// Extract metadata\nconst title = grab(\"title\", \"\");\nconst ogTitle = grabMeta(\"og:title\") || title;\n\n// Return structured metadata\nreturn [\n  {\n    json: {\n      url,\n      title: ogTitle || title || \"No Title Found\",\n      date_added: new Date().toISOString()\n    }\n  }\n];\n"
      },
