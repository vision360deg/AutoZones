        "jsCode": "const sw5 = $input.all()[0].json;\nconst sw1 = $('Check SW1 Result').all()[0]?.json || {};\nconst sw2 = $('Check SW2 Result').all()[0]?.json || {};\nconst sw3 = $('Check SW3 Result').all()[0]?.json || {};\nconst sw4 = $('Check SW4 Result').all()[0]?.json || {};\n\nreturn [{\n  json: {\n    pipeline_status: 'success',\n    founder_profile: sw1.founder_profile || {},\n    investors_found: (sw2.investors || []).length,\n    connected_founders_found: (sw3.connected_founders || []).length,\n    events_discovered: (sw4.events || []).length,\n    weekly_recommendations: sw5.weekly_recommendations || [],\n    total_recommended_events: sw5.total_recommended || 0,\n    summary: {\n      top_investors: (sw2.investors || []).slice(0, 5).map(i => `${i.name} (${i.investor_type}, ${i.connection_degree})`),\n      top_connected_founders: (sw3.connected_founders || []).slice(0, 5).map(f => `${f.name} - ${f.mutual_connections_count} mutual connections`),\n      next_recommended_events: (sw5.weekly_recommendations || []).slice(0, 2).flatMap(w => w.events.map(e => `${e.event_name} on ${e.date} at ${e.location}`))\n    },\n    timestamp: new Date().toISOString()\n  }\n}];\n"
