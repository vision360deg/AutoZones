    {
      "parameters": {
        "jsCode": "function parseInput(text) {\n  const input = text.trim();\n  const [kind, ...rest] = input.split(/\\s+/);\n  const command = kind.split(\"<\")[0];\n  const id_value = rest.join(\" \").trim();\n\n  switch (command) {\n    case \"GET_STATUS\":\n      if (!id_value) throw new Error(\"Missing ID value\");\n      return { type: kind, id: id_value };\n\n    case \"SET_STATUS\":\n      if (!id_value) throw new Error(\"Missing ID value\");\n      return { type: kind, id: id_value };\n\n    case \"SET_TASK_DONE\":\n      if (!id_value) throw new Error(\"Missing ID value\");\n      return { type: kind, id: id_value };\n\n    default:\n      throw new Error(\"Invalid input. Expected 'SET_TASK_DONE <value>', 'GET_STATUS <value>', or 'SET_STATUS <value>'\");\n  }\n}\n\nconst inputText = $('Telegram Callback Trigger').first().json.callback_query.data;\n\nconst parsed = parseInput(inputText);\n\nreturn [{ json: parsed }];"
      },
