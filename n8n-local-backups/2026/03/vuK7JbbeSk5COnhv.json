    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst action = ({\n  status: \"GET_STATUS\",\n  update: \"SET_STATUS<\" + $('Parse Slash Command').first().json.new_status + \">\",\n})[$('Parse Slash Command').first().json.command];\n\nif (!action) throw new Error(\"Invalid command\");\n\nconst buttons = items.map((item) => ([\n  {\n    text: item.json.name,\n    callback_data: action + ' ' + String(item.json.id),\n  }\n]));\n\nreturn [{\n  json: {\n    chat_id: $('Telegram Contact Status Trigger').first().json.message.chat.id,\n    text: \"Choose one:\",\n    reply_markup: {\n      inline_keyboard: buttons\n    }\n  }\n}];"
      },
