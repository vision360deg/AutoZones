    {
      "parameters": {
        "jsCode": "const STATUS_RE = /^\\/status\\s+(.+?)\\s*$/;\nconst UPDATE_RE = /^\\/update\\s+(.+?)\\s+(\\S+)\\s*$/;\n\nfunction parseMessage(text) {\n  text = text.trim();\n\n  let m = text.match(STATUS_RE);\n  if (m) {\n    return {\n      command: \"status\",\n      contact_name: m[1].trim(),\n      new_status: null,\n    };\n  }\n\n  m = text.match(UPDATE_RE);\n  if (m) {\n    return {\n      command: \"update\",\n      contact_name: m[1].trim(),\n      new_status: m[2].trim(),\n    };\n  }\n\n  throw new Error(\"Invalid command format\");\n}\n\nconst inputMessage = $('Telegram Contact Status Trigger').first().json.message.text;\nconst parsed = parseMessage(inputMessage);\n\nreturn [{ json: parsed }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
